 {"name":"Standard_E8s_v5","family":"standardESv5Family","capabilities":[{"name":"vCPUs","value":"8"},{"name":"MemoryGB","value":"64"}],"locationInfo":[{"location":"eastus","zones":["1","2","3"]}],"restrictions":[{"type":"Zone","values":["eastus"],"reasonCode":"NotAvailableForSubscription","restrictionInfo":{"locations":["eastus"],"zones":["3"]}}]},
