#!/usr/bin/env bash
# Mock Azure CLI for testing azure-vm-sku-report.sh
#   MOCK_LOG=<file>  append every call (to verify the script only runs read-only commands)
#   MOCK_EVIL=1      add a SKU/subscription with HTML, quotes and CSV-formula payloads (security test)
[[ -n "${MOCK_LOG:-}" ]] && printf '%q ' "$@" >> "$MOCK_LOG" && echo >> "$MOCK_LOG"
# Drop "--subscription X" so the case patterns below match
a=(); while (($#)); do if [[ "$1" == "--subscription" ]]; then shift 2; else a+=("$1"); shift; fi; done; set -- "${a[@]}"
loc=""; args=("$@"); for ((i=0;i<${#args[@]};i++)); do [[ "${args[i]}" == "--location" ]] && loc="${args[i+1]}"; done
case "$*" in
 "account show") echo '{}';;
 account\ set*) exit 0;;
 "account show --query name -o tsv") if [[ -n "${MOCK_EVIL:-}" ]]; then echo 'Evil</script><script>alert("sub")</script>'; else echo "${MOCK_SUBNAME:-Contoso-Prod}"; fi;;
 "account show --query id -o tsv") echo "00000000-1111-2222-3333-444444444444";;
 account\ list-locations*) printf 'eastus\nwestus\nbrokenregion\n';;
 vm\ list-skus*)
  if [[ "$loc" == "westus" ]]; then echo '[]'; exit 0; fi
  if [[ "$loc" == "brokenregion" ]]; then echo "ERROR: (NoRegisteredProviderFound) mock failure" >&2; exit 1; fi
  if [[ -n "${MOCK_EVIL:-}" ]]; then cat <<'J'
[{"name":"Standard_X</script><img src=x onerror=alert(1)>","family":"=HYPERLINK(\"http://evil\",\"x\")","capabilities":[{"name":"vCPUs","value":"2"},{"name":"MemoryGB","value":"4"}],"locationInfo":[{"location":"eastus","zones":["1\"><svg onload=alert(2)>"]}],"restrictions":[{"type":"Location","reasonCode":"<b>x</b>' onmouseover='alert(3)","restrictionInfo":{"locations":["eastus"]}}]},
 {"name":"+cmd|' /C calc'!A0","family":"@SUM(1+1)","capabilities":[{"name":"vCPUs","value":"2"}],"locationInfo":[{"location":"eastus","zones":["1"]}],"restrictions":[]},
 {"name":"Standard_Y; rm -rf ~ #<!--<script>","family":"-2+3","capabilities":[{"name":"vCPUs","value":"2"}],"locationInfo":[{"location":"eastus","zones":["1"]}],"restrictions":[]}]
J
  exit 0; fi
